# SalonFlow environment variables
# Local: copy to .env.local (never commit it). Vercel: Project Settings > Environment Variables.
# Values: Supabase Dashboard > Project Settings > API Keys / Data API.

# Required by the web app (server side only). Public values; access is limited by RLS.
# App-specific names so hosting integrations cannot override them.
SALONFLOW_SUPABASE_URL=https://<project-ref>.supabase.co
SALONFLOW_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Server only — bypasses RLS. Not used by the web app yet (reserved for later phases).
# Never prefix with NEXT_PUBLIC_, never send to the browser.
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Optional: direct Postgres connection for running supabase/tests/*.sh locally.
# Dashboard > Connect > Session pooler. Contains the database password.
# DATABASE_URL=
