# SalonFlow environment variables
# Copy to .env.local and fill in the values. Never commit .env.local.
# Values: Supabase Dashboard > Project Settings > API Keys / Data API.

# Public (safe in the browser; access is limited by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Server only — bypasses RLS. Never prefix with NEXT_PUBLIC_, never send to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Optional: direct Postgres connection for running supabase/tests/*.sh locally.
# Dashboard > Connect > Session pooler. Contains the database password.
DATABASE_URL=
